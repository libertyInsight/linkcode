{
  "rewrites": [
    {
      "source": "/wait",
      "destination": "/index.html"
    },
    {
      "source": "/:code(\\d{6})",
      "destination": "/api/open?code=:code&go=1"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}