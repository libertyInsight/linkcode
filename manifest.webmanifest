{
  "name": "링크코드",
  "short_name": "링크코드",
  "description": "긴 링크나 파일을 6자리 코드로 바꿔 전자칠판에서 바로 열기",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f1ea",
  "theme_color": "#14213d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["*/*", "image/*", "video/*", "application/pdf", ".ppt", ".pptx", ".doc", ".docx", ".xls", ".xlsx", ".hwp", ".hwpx"] }
      ]
    }
  }
}
